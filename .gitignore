.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.vscode/

# Artefatos do experimento (grandes e reproduzíveis pela CLI)
outputs/experiment/
data/raw/
data/corpus/*.jsonl
data/corpus/_manifest.json

# Dados do estudo de viabilidade (texto da Wikipédia, 7 MB)
scripts/feasibility/*.jsonl

# Arquivos auxiliares do LaTeX
report/**/*.aux
report/**/*.log
report/**/*.fls
report/**/*.fdb_latexmk
report/**/*.synctex.gz
report/**/*.out
report/**/*.toc
report/**/*.bbl
report/**/*.blg
report/**/*.xdv

# PDFs: só os documentos entregues (proposta e entregas parciais) são versionados; o do
# relatório técnico é gerado com latexmk.
report/relatorio/relatorio.pdf
